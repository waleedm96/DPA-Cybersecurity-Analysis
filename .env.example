
# Copy this file to .env in the project root, then edit your values if needed.
# Recreating the container resets notebook kernels; save your work first.

# Opens the JupyterLab interface when the container starts.
JUPYTER_ENABLE_LAB=yes

# Token used to sign in at http://127.0.0.1:8888/lab.
JUPYTER_TOKEN=sentinel-local

# Print Python output immediately instead of buffering it in container logs.
PYTHONUNBUFFERED=1

# Give the notebook user (jovyan) ownership of its home directory at startup.
# This supports writing notebooks and generated outputs inside the container.
CHOWN_HOME=yes

# Apply the ownership change recursively to files and subdirectories.
CHOWN_HOME_OPTS=-R

# Allow the notebook user to run sudo inside the container without a password
GRANT_SUDO=yes

# Spark settings are maintained separately in config/spark-defaults.conf.
# SPARK_CONF_DIR is fixed in docker-compose.yml to match the project mount;

